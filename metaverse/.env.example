# このファイルを .env という名前でコピーして、値を入れてください（.env は Git に含めません）
# LiveKit Cloud の「Settings → API Keys」で確認できます
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 本番（HTTPS）では必ず設定
# NODE_ENV=production
# TRUST_PROXY=1

# データの保存先（無料のサーバーで再起動してもデータを消さないため）
# Neon（https://neon.com）の接続文字列。未設定ならサーバーの中だけに保存します
# DATABASE_URL=postgresql://ユーザー:パスワード@ホスト/データベース?sslmode=require
